@import url('https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700&display=swap');

:root {
  --primary: #2563eb;
  --primary-dark: #1d4ed8;
  --accent: #f59e0b;
  --bg: #f0f4ff;
  --header-footer-bg: #1e3a8a;
  --box-colors: #60a5fa, #34d399, #f472b6, #fb923c, #a78bfa, #38bdf8;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: 'Sora', sans-serif;
  background: var(--bg);
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

/* HEADER */
header {
  background: var(--header-footer-bg);
  color: #fff;
  padding: 20px 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16px;
}

header h1 {
  font-size: clamp(1.1rem, 3vw, 1.6rem);
  font-weight: 700;
  letter-spacing: 0.02em;
}

header .logo-dot {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: var(--accent);
  display: inline-block;
}

/* MAIN */
main {
  flex: 1;
  padding: 40px 20px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32px;
}

/* Control Card */
.control-card {
  background: #fff;
  border-radius: 14px;
  padding: 28px 36px;
  box-shadow: 0 4px 24px rgba(37,99,235,.10);
  display: flex;
  align-items: center;
  gap: 14px;
  flex-wrap: wrap;
  justify-content: center;
  width: 100%;
  max-width: 480px;
}

.control-card label {
  font-size: 0.9rem;
  font-weight: 600;
  color: #334155;
  white-space: nowrap;
}

.control-card input[type="number"] {
  width: 90px;
  border: 2px solid #cbd5e1;
  border-radius: 8px;
  padding: 8px 12px;
  font-size: 1rem;
  font-family: 'Sora', sans-serif;
  outline: none;
  transition: border-color .2s;
}

.control-card input[type="number"]:focus {
  border-color: var(--primary);
}

.btn-generate {
  background: var(--primary);
  color: #fff;
  border: none;
  border-radius: 8px;
  padding: 9px 22px;
  font-size: 0.9rem;
  font-weight: 600;
  cursor: pointer;
  font-family: 'Sora', sans-serif;
  transition: background .2s, transform .1s;
}

.btn-generate:hover {
  background: var(--primary-dark);
}

.btn-generate:active {
  transform: scale(0.97);
}

/* Box Container */
#box-container {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  justify-content: center;
  width: 100%;
  max-width: 900px;
}

.square-box {
  width: 120px;
  height: 120px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.4rem;
  font-weight: 700;
  color: #fff;
  box-shadow: 0 4px 14px rgba(0,0,0,.12);
  animation: popIn .3s cubic-bezier(.34,1.56,.64,1) both;
}

@keyframes popIn {
  from {
    opacity: 0;
    transform: scale(0.5);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.empty-msg {
  color: #94a3b8;
  font-size: 0.9rem;
  text-align: center;
}

/* FOOTER */
footer {
  background: var(--header-footer-bg);
  color: #93c5fd;
  text-align: center;
  padding: 18px 40px;
  font-size: 0.8rem;
  letter-spacing: 0.03em;
}

footer span {
  color: var(--accent);
  font-weight: 600;
}
