<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Soal 2 – Square Box Generator</title>

  
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/>

 
  <link rel="stylesheet" href="style.css">
</head>
<body>

  
  <header>
    <span class="logo-dot"></span>
    <h1>Square Box Generator</h1>
    <span class="logo-dot"></span>
  </header>

  <!-- MAIN -->
  <main>
    <div class="control-card">
      <label for="jumlah">Jumlah Box:</label>
      <input type="number" id="jumlah" min="1" max="100" value="6" />
      <button class="btn-generate" onclick="generateBoxes()">Generate</button>
    </div>

    <div id="box-container">
      <p class="empty-msg">Klik Generate untuk menampilkan box.</p>
    </div>
  </main>

  <!-- FOOTER -->
  <footer>
    &copy; 2024 &nbsp;|&nbsp; Dibuat dengan <span>Bootstrap 5</span> &amp; HTML
  </footer>

  <script>
    const palette = [
      '#2563eb','#10b981','#f59e0b','#ef4444',
      '#8b5cf6','#06b6d4','#ec4899','#84cc16',
      '#f97316','#6366f1'
    ];

    function generateBoxes() {
      const n = parseInt(document.getElementById('jumlah').value) || 0;
      const container = document.getElementById('box-container');
      container.innerHTML = '';

      if (n < 1) {
        container.innerHTML = '<p class="empty-msg">Masukkan angka minimal 1.</p>';
        return;
      }
      if (n > 100) {
        container.innerHTML = '<p class="empty-msg">Maksimal 100 box.</p>';
        return;
      }

      for (let i = 1; i <= n; i++) {
        const div = document.createElement('div');
        div.className = 'square-box';
        div.textContent = i;
        div.style.background = palette[(i - 1) % palette.length];
        div.style.animationDelay = `${(i - 1) * 0.04}s`;
        container.appendChild(div);
      }
    }

    generateBoxes();
  </script>

</body>
</html>
